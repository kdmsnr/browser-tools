{
  "manifest_version": 3,
  "name": "TVer Watched Program Remover",
  "version": "1.3.1",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "description": "Remove watched programs from the My Page of TVer.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Toggle TVer Watched Remover",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tver.jp/*"],
      "js": ["watched-core.js", "duration-filter.js", "main.js"],
      "run_at": "document_end"
    }
  ]
}
